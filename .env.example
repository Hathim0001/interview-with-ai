# ─── Authentication (Clerk) ───────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Full connection string — Supabase, Neon, Railway, or local Postgres
DATABASE_URL=

# ─── AI (Google Gemini) ──────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Video & Chat (Stream) ───────────────────────────────────────────────────
# Get from https://dashboard.getstream.io → your app → Overview
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=

# ─── Security (Arcjet) ───────────────────────────────────────────────────────
# Get from https://app.arcjet.com
ARCJET_KEY=

# ─── Payments (Clerk Billing) ────────────────────────────────────────────────
# Optional — only needed if using Clerk's built-in billing portal
NEXT_PUBLIC_CLERK_BILLING_URL=
